# ==============================================================================
# TwinIQ Platform - Production Environment Variables Template
# Copy this file to .env and customize values for production deployment
# ==============================================================================

# --- DATABASE CONFIGURATION ---
POSTGRES_DB=twiniq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/twiniq
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# --- BACKEND APPLICATION CONFIGURATION ---
PORT=8081
SPRING_PROFILES_ACTIVE=prod
SHOW_SQL=false
DDL_AUTO=update

# --- SECURITY & JWT ---
# Minimum 256-bit secure secret key
JWT_SECRET=TwinIQ2026SuperSecureSecretKeyForCognitiveBusinessTwinPlatformMustBe256BitsLong!
JWT_EXPIRATION_MS=86400000

# --- CORS ORIGINS ---
# Comma-separated list of allowed origins (e.g., https://twiniq.vercel.app,https://yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# --- FRONTEND CONFIGURATION ---
# Base URL pointing to the backend API
# For Docker / same-domain proxy: /api
# For decoupled deployments: https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8081/api
