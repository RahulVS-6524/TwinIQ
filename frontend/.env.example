# TwinIQ Frontend Environment Variables Template
# Copy this file to .env.local or set in your cloud deployment dashboard (e.g. Vercel, Render)

# Base URL pointing to the Spring Boot REST API
# For local dev: http://localhost:8081/api
# For same-domain / Docker proxy: /api
# For decoupled cloud: https://your-twiniq-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8081/api
